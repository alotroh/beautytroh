# ------------------------------------------------------------------
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ ПРИЁМА ЗАЯВОК (форма записи → Telegram)
# ------------------------------------------------------------------
# Эти значения НЕ хранятся в репозитории. Их нужно добавить в Vercel:
#   Project → Settings → Environment Variables
# (можно для окружений Production + Preview). После добавления —
# сделать Redeploy, чтобы функция /api/lead увидела переменные.
#
# Локально для теста можно скопировать файл в .env (он в .gitignore).
# Пока переменные не заданы, форма работает в concept-режиме: не падает,
# а мягко предлагает написать напрямую в мессенджер.

# Токен бота из @BotFather (пример формата: 123456789:AA...xyz)
TELEGRAM_BOT_TOKEN=

# Ваш chat id, куда бот присылает заявки на запись.
# Узнать: напишите боту, затем спросите свой id у @userinfobot
TELEGRAM_CHAT_ID=
