---
/**
 * Шапка сайта. Навигация — обычные HTML-ссылки (не зависят от JS).
 * `transparent` — прозрачный вариант поверх тёмного hero на главной.
 */
import { SITE, NAV, CTA } from '../config/site.mjs';

interface Props {
  transparent?: boolean;
  currentPath?: string;
}
const { transparent = false, currentPath = '' } = Astro.props;
---

<header class={`site-header${transparent ? ' site-header--transparent' : ''}`} data-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${SITE.brand}, на главную`}>
      <span class="site-header__name">{SITE.brand}</span>
      <span class="site-header__tag">{SITE.brandTagline}</span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn site-header__cta" href="#booking" data-track="click_booking">{CTA.book}</a>

    <button class="site-header__burger" aria-label="Открыть меню" aria-expanded="false" data-burger>
      <span></span><span></span>
    </button>
  </div>

  <!-- Мобильное меню -->
  <div class="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Мобильная навигация">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn mobile-menu__cta" href="#booking" data-track="click_booking">{CTA.book}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(30, 20, 12, 0.72);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
    color: var(--ivory);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .site-header--transparent {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    border-color: transparent;
    color: var(--ivory);
  }
  .site-header--transparent.is-scrolled {
    position: fixed;
    background: rgba(30, 20, 12, 0.82);
    backdrop-filter: blur(14px);
    border-color: rgba(247, 240, 239, 0.12);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 84px;
  }
  .site-header__brand {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .site-header__name {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: inherit;
  }
  .site-header--transparent .site-header__name,
  .site-header--transparent .site-header__tag {
    color: var(--ivory);
  }
  .site-header__tag {
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 2px;
  }
  .site-nav { margin-left: auto; }
  .site-nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-nav a {
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: inherit;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), opacity 0.3s var(--ease);
    opacity: 0.85;
  }
  .site-header--transparent .site-nav a { color: var(--ivory); }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    opacity: 1;
    border-color: var(--accent);
  }
  .site-header__cta {
    padding: 0.75em 1.4em;
    font-size: 0.86rem;
  }
  .site-header--transparent .site-header__cta {
    --btn-bg: var(--ivory);
    --btn-fg: var(--espresso);
  }
  .site-header__burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    width: 40px;
    height: 40px;
    padding: 9px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: inherit;
  }
  .site-header__burger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .site-header--transparent .site-header__burger { color: var(--ivory); }
  .site-header__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .site-header__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    padding: 1.5rem var(--gutter) 2.5rem;
    background: var(--espresso);
    color: var(--ivory);
  }
  .mobile-menu[hidden] { display: none !important; }
  .mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .mobile-menu a {
    display: block;
    font-family: var(--font-display);
    font-size: 1.9rem;
    padding: 0.4rem 0;
    color: var(--ivory);
    border-bottom: 1px solid rgba(247, 240, 239, 0.1);
  }
  .mobile-menu__cta {
    --btn-bg: var(--ivory);
    --btn-fg: var(--espresso);
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 940px) {
    .site-nav,
    .site-header__cta { display: none; }
    .site-header__burger { display: flex; }
    .mobile-menu.is-open { display: block; }
  }
</style>

<script>
  // Прозрачная шапка над hero: затемняется после прокрутки.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header?.classList.contains('site-header--transparent')) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 40);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Мобильное меню
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (burger && menu) {
    const toggle = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      menu.hidden = !open;
      menu.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
    // Закрытие по Esc — для доступности с клавиатуры.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        toggle(false);
        burger.focus();
      }
    });
  }
</script>
