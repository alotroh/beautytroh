---
/**
 * GradientBackground — единый живой фон сайта.
 * ------------------------------------------------------------------
 * Идея из присланного «Almoayyed» (21st.dev): цельное полотно из мягких
 * цветовых пятен (вино, слива, роза) с зерном. Реализовано на чистом CSS,
 * фиксированным слоем на весь сайт. Отдельный слой очень медленно «дышит»
 * (только transform → дёшево для GPU), поэтому фон читается как настоящий
 * градиент, а не плоская заливка. Уважает prefers-reduced-motion.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div aria-hidden="true" class={`gradient-bg ${className ?? ''}`}>
  <div class="gradient-bg__base"></div>
  <div class="gradient-bg__aura"></div>
  <svg aria-hidden="true" class="gradient-bg__grain">
    <filter id="grain-dc893a4f">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-dc893a4f)"></rect>
  </svg>
</div>

<style>
  .gradient-bg {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
  }
  /* Базовое полотно: тёплый мокко-градиент (à la Vogem) — карамельные блики
     по краям, глубокий браун в центре-снизу, кремовый текст читается. */
  .gradient-bg__base {
    position: absolute;
    inset: 0;
    background-color: #241811;
    background-image:
      radial-gradient(70% 60% at 86% 10%, rgba(198, 150, 102, 0.55), rgba(198, 150, 102, 0) 60%),
      radial-gradient(80% 70% at 96% 92%, rgba(140, 96, 60, 0.55), rgba(140, 96, 60, 0) 62%),
      radial-gradient(72% 62% at 8% 6%, rgba(104, 74, 46, 0.7), rgba(104, 74, 46, 0) 60%),
      radial-gradient(85% 82% at 0% 98%, rgba(44, 29, 18, 0.95), rgba(44, 29, 18, 0) 64%),
      linear-gradient(150deg, #3c2a1a 0%, #201509 52%, #2f2113 100%);
  }
  /* «Дышащий» слой: крупные мягкие карамельно-мокко области, заметный дрейф. */
  .gradient-bg__aura {
    position: absolute;
    inset: -25%;
    background-image:
      radial-gradient(40% 38% at 26% 28%, rgba(220, 176, 122, 0.34), rgba(220, 176, 122, 0) 68%),
      radial-gradient(46% 44% at 76% 70%, rgba(150, 104, 62, 0.42), rgba(150, 104, 62, 0) 70%),
      radial-gradient(30% 30% at 62% 18%, rgba(206, 160, 108, 0.28), rgba(206, 160, 108, 0) 72%);
    background-repeat: no-repeat;
    animation: bgDrift 40s ease-in-out infinite alternate;
    will-change: transform;
  }
  .gradient-bg__grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.18;
    mix-blend-mode: overlay;
  }
  @keyframes bgDrift {
    0% { transform: translate3d(-7%, -5%, 0) scale(1.08) rotate(-1deg); }
    100% { transform: translate3d(7%, 5%, 0) scale(1.22) rotate(1deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gradient-bg__aura { animation: none; transform: none; }
  }
</style>
