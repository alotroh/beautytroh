---
/**
 * GradientBackground — единый живой фон сайта.
 * ------------------------------------------------------------------
 * Идея из присланного «Almoayyed» (21st.dev): цельное полотно из мягких
 * цветовых пятен (вино, слива, роза) с зерном. Реализовано на чистом CSS,
 * фиксированным слоем на весь сайт. Отдельный слой очень медленно «дышит»
 * (только transform → дёшево для GPU), поэтому фон читается как настоящий
 * градиент, а не плоская заливка. Уважает prefers-reduced-motion.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div aria-hidden="true" class={`gradient-bg ${className ?? ''}`}>
  <div class="gradient-bg__base"></div>
  <div class="gradient-bg__aura"></div>
  <svg aria-hidden="true" class="gradient-bg__grain">
    <filter id="grain-dc893a4f">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-dc893a4f)"></rect>
  </svg>
</div>

<style>
  .gradient-bg {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
  }
  /* Базовое полотно: тёплый мокко-градиент (à la Vogem) — карамельные блики
     по краям, глубокий браун в центре-снизу, кремовый текст читается. */
  .gradient-bg__base {
    position: absolute;
    inset: 0;
    background-color: #0a090c;
    background-image:
      radial-gradient(60% 52% at 88% 6%, rgba(255, 79, 151, 0.16), rgba(255, 79, 151, 0) 60%),
      radial-gradient(72% 64% at 4% 100%, rgba(255, 79, 151, 0.12), rgba(255, 79, 151, 0) 62%),
      radial-gradient(60% 55% at 12% 4%, rgba(120, 30, 70, 0.22), rgba(120, 30, 70, 0) 60%),
      radial-gradient(90% 85% at 100% 98%, rgba(5, 4, 7, 0.95), rgba(5, 4, 7, 0) 64%),
      linear-gradient(155deg, #100b11 0%, #08070a 52%, #0d0910 100%);
  }
  /* «Дышащий» слой: мягкие розовые области на чёрном, очень сдержанный дрейф. */
  .gradient-bg__aura {
    position: absolute;
    inset: -25%;
    background-image:
      radial-gradient(40% 38% at 24% 26%, rgba(255, 99, 163, 0.14), rgba(255, 99, 163, 0) 68%),
      radial-gradient(46% 44% at 78% 72%, rgba(230, 60, 130, 0.16), rgba(230, 60, 130, 0) 70%),
      radial-gradient(30% 30% at 64% 16%, rgba(255, 120, 180, 0.10), rgba(255, 120, 180, 0) 72%);
    background-repeat: no-repeat;
    animation: bgDrift 40s ease-in-out infinite alternate;
    will-change: transform;
  }
  .gradient-bg__grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.18;
    mix-blend-mode: overlay;
  }
  @keyframes bgDrift {
    0% { transform: translate3d(-7%, -5%, 0) scale(1.08) rotate(-1deg); }
    100% { transform: translate3d(7%, 5%, 0) scale(1.22) rotate(1deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gradient-bg__aura { animation: none; transform: none; }
  }
</style>
