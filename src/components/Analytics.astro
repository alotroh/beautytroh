---
/**
 * Аналитика — Яндекс Метрика, Google Analytics (gtag) и/или GTM.
 * Скрипты подключаются ТОЛЬКО если задан соответствующий ID в
 * src/config/site.mjs → ANALYTICS. Пока ID пустые — ничего не грузится
 * (нулевая нагрузка на страницу в концепт-режиме).
 *
 * Отслеживание событий работает без правки компонентов: любой элемент с
 * атрибутом data-track="имя_события" отправит цель в Метрику и событие в GA.
 * Имена: click_booking, click_phone, click_telegram, click_whatsapp,
 * click_service, article_to_booking.
 */
import { ANALYTICS } from '../config/site.mjs';

const { yandexMetrikaId, googleAnalyticsId, googleTagManagerId } = ANALYTICS;
const hasYm = Boolean(yandexMetrikaId);
const hasGa = Boolean(googleAnalyticsId);
const hasGtm = Boolean(googleTagManagerId);
const anyAnalytics = hasYm || hasGa || hasGtm;
---

{
  hasGtm && (
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${googleTagManagerId}');`} />
  )
}

{
  hasGa && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${googleAnalyticsId}');`} />
    </>
  )
}

{
  hasYm && (
    <script is:inline set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${yandexMetrikaId},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:false});`} />
  )
}

{
  anyAnalytics && (
    <script
      is:inline
      set:html={`(function(){var YM=${hasYm ? Number(yandexMetrikaId) : 'null'};function track(name){if(!name)return;try{if(YM&&window.ym){window.ym(YM,'reachGoal',name);}}catch(e){}try{if(window.gtag){window.gtag('event',name);}}catch(e){}try{if(window.dataLayer){window.dataLayer.push({event:name});}}catch(e){}}document.addEventListener('click',function(e){var el=e.target.closest('[data-track]');if(el){track(el.getAttribute('data-track'));}},{passive:true});})();`}
    />
  )
}
