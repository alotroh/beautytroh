---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookingSection from '../../components/BookingSection.astro';
import ServiceArticle from '../../components/ServiceArticle.astro';
import { SERVICES, getService } from '../../data/services.mjs';
import { serviceSchema, faqSchema } from '../../config/schema.mjs';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = getService(slug);
if (!service) return Astro.redirect('/404/');

const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];

const jsonLd = [serviceSchema(service), faqSchema(service.faq)].filter(Boolean) as Record<string, any>[];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  path={`/services/${service.slug}/`}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">{service.eyebrow}</span>
      <h1>{service.title}</h1>
      <p class="lead page-hero__lead">{service.heroLead}</p>
      <div class="page-hero__actions">
        <a class="btn" href="#booking" data-track="click_booking">Записаться <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link-arrow" href="/prices/">Цены</a>
      </div>
    </div>
  </section>

  <ServiceArticle service={service} />

  <BookingSection
    heading={`Записаться · ${service.title}`}
    text="Оставьте контакт. Подберём удобное время и мастера, а точную процедуру определим после диагностики."
    service={service.slug}
  />
</BaseLayout>
