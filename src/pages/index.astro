    .team-preview { grid-template-columns: 1fr; max-width: 340px; }
    .gallery__cell--tall { grid-row: span 1; }
    .hero__facts { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Двухэтапный hero: блокируем прокрутку, пока гость не нажал «смотреть».
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const intro = hero?.querySelector<HTMLElement>('[data-hero-stage="intro"]');
  const dirs = hero?.querySelector<HTMLElement>('[data-hero-stage="dirs"]');
  const enterBtn = hero?.querySelector<HTMLElement>('[data-hero-enter]');
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && intro && dirs && enterBtn) {
    let entered = false;

    const enter = (animate = true) => {
      if (entered) return;
      entered = true;
      root.classList.remove('hero-locked');
      dirs.classList.add('is-active');
      dirs.removeAttribute('inert');
      dirs.setAttribute('aria-hidden', 'false');
      intro.classList.add('is-leaving');
      intro.setAttribute('aria-hidden', 'true');
      intro.setAttribute('inert', '');
      const hideIntro = () => intro.classList.add('is-gone');
      if (animate && !reduce) setTimeout(hideIntro, 1250);
      else hideIntro();
      const h = dirs.querySelector<HTMLElement>('.hero-dirs__title');
      if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
    };

    const hasHash = location.hash && location.hash !== '#top';
    if (hasHash) {
      // Глубокая ссылка (напр. /#booking) — не запираем, сразу показываем сайт.
      enter(false);
    } else {
      root.classList.add('hero-locked');
      dirs.setAttribute('inert', '');
      window.scrollTo(0, 0);
      enterBtn.addEventListener('click', () => enter(true));
    }

    // «Листать дальше» — плавный скролл к следующей секции.
    const more = dirs.querySelector<HTMLAnchorElement>('[data-hero-continue]');
    more?.addEventListener('click', (e) => {
      e.preventDefault();
      const sel = more.getAttribute('href') || '';
      const target = sel ? document.querySelector(sel) : null;
      target?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
