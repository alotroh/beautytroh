---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingSection from '../components/BookingSection.astro';
import PackagesSection from '../components/PackagesSection.astro';
import MasterCard from '../components/MasterCard.astro';
import Figure from '../components/Figure.astro';
import { Image } from 'astro:assets';
import { SERVICES } from '../data/services.mjs';
import { TEAM } from '../data/team.mjs';
import { POSTS } from '../data/posts.mjs';
import { SERVICE_IMAGES, INTERIOR, HAIR_STRIP, HERO_IMAGE } from '../data/media.mjs';
import { websiteSchema, organizationSchema, beautyBusinessSchema } from '../config/schema.mjs';

const teamPreview = TEAM.slice(0, 3);
const latestPosts = POSTS.slice(0, 3);

// Слайды hero — один статичный фон, поверх листается текст.
interface HeroSlide {
  eyebrow: string;
  title: string;      // {em} ... {/em} выделяет карамельную строку
  lead: string;       // {hl} ... {/hl} выделяет ключевые слова
  cta: { label: string; href: string };
  secondary: { label: string; href: string };
}
const heroSlides: HeroSlide[] = [
  {
    eyebrow: 'Студия красоты · Концепт',
    title: 'Красиво, когда {em}сделано хорошо{/em}',
    lead: 'Сюда приходят не за процедурой, а за {hl}результатом{/hl} и {hl}работой мастера{/hl}. Волосы, окрашивание, маникюр, брови и уход за лицом.',
    cta: { label: 'Записаться', href: '#booking' },
    secondary: { label: 'Посмотреть услуги', href: '/services/' },
  },
  {
    eyebrow: '5 направлений · одна студия',
    title: 'Ваш образ — {em}в одних руках{/em}',
    lead: 'Волосы, окрашивание, маникюр, брови и уход за лицом — всё в {hl}одном пространстве{/hl}, спокойно и без спешки.',
    cta: { label: 'Записаться', href: '#booking' },
    secondary: { label: 'Посмотреть услуги', href: '/services/' },
  },
  {
    eyebrow: 'Честный подход',
    title: 'Результат, {em}а не процедуры{/em}',
    lead: 'Обсуждаем, что реально получится {hl}именно у вас{/hl}, ещё до начала. Если задуманное не подойдёт — скажем честно.',
    cta: { label: 'Записаться', href: '#booking' },
    secondary: { label: 'О студии', href: '/about/' },
  },
];

// Плитки визуальной галереи — реальные фото по направлениям, асимметрия.
// У «Волос» широкая плитка с ДВУМЯ фото рядом (hair + hair 2).
interface GalleryTile {
  label: string;
  img?: ImageMetadata;
  imgs?: ImageMetadata[];
  tone: string;
  ratio: string;
  span: string;
}
const gallery: GalleryTile[] = [
  { label: 'Окрашивание', img: SERVICE_IMAGES.okrashivanie, tone: 'warm', ratio: '4/5', span: 'tall' },
  { label: 'Маникюр', img: SERVICE_IMAGES.manikyur, tone: 'light', ratio: '1/1', span: '' },
  { label: 'Брови', img: SERVICE_IMAGES.brovi, tone: 'warm', ratio: '1/1', span: '' },
  { label: 'Уход за лицом', img: SERVICE_IMAGES['uhod-za-litsom'], tone: 'light', ratio: '4/5', span: 'tall' },
  { label: 'Волосы', imgs: HAIR_STRIP, tone: 'warm', ratio: '16/10', span: 'wide' },
];

// Превращает {em}...{/em} и {hl}...{/hl} в безопасный HTML (контент наш, статичный).
const renderRich = (s: string) =>
  s
    .replace(/\{em\}/g, '<em>').replace(/\{\/em\}/g, '</em>')
    .replace(/\{hl\}/g, '<span class="hl">').replace(/\{\/hl\}/g, '</span>');

const jsonLd = [websiteSchema(), organizationSchema({ logo: '/favicon.svg' }), beautyBusinessSchema({ image: '/images/og-cover.svg' })];
---

<BaseLayout seoKey="home" transparentHeader={true} jsonLd={jsonLd}>
  <!-- 01 · HERO (статичный фон + листаемые текст-слайды) -->
  <section class="hero theme-dark" aria-labelledby="hero-title">
    <div class="hero__photo" aria-hidden="true">
      <Image
        src={HERO_IMAGE}
        alt=""
        widths={[600, 900, 1300, 1700]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__shimmer" aria-hidden="true"></div>
      <div class="hero__veil"></div>
    </div>

    <div class="container hero__inner">
      <div
        class="hero__slider"
        data-hero-slider
        data-autoplay="6500"
        role="region"
        aria-roledescription="карусель"
        aria-label="Главные сообщения студии"
      >
        <div class="hero__track" data-hero-track>
          {heroSlides.map((slide, i) => (
            <article
              class="hero__slide"
              data-hero-slide
              role="group"
              aria-roledescription="слайд"
              aria-label={`${i + 1} из ${heroSlides.length}`}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <div class="hero__text">
                <span class="eyebrow eyebrow--rule"><span class="hero__dot" aria-hidden="true"></span>{slide.eyebrow}</span>
                {i === 0 ? (
                  <h1 id="hero-title" class="hero__title" set:html={renderRich(slide.title)} />
                ) : (
                  <p class="hero__title" set:html={renderRich(slide.title)} />
                )}
                <p class="lead hero__lead" set:html={renderRich(slide.lead)} />
                <div class="hero__actions">
                  <a class="btn hero__cta" href={slide.cta.href} data-track="click_booking">
                    {slide.cta.label} <span class="arrow" aria-hidden="true">→</span>
                  </a>
                  <a class="link-arrow hero__secondary" href={slide.secondary.href}>{slide.secondary.label}</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="hero__controls">
          <button class="hero__arrow" type="button" data-hero-prev aria-label="Предыдущий слайд">
            <span aria-hidden="true">←</span>
          </button>
          <div class="hero__dots" data-hero-dots role="tablist" aria-label="Выбор слайда">
            {heroSlides.map((_, i) => (
              <button
                class="hero__dot-btn"
                type="button"
                data-hero-dot={i}
                role="tab"
                aria-label={`Слайд ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              ></button>
            ))}
          </div>
          <button class="hero__arrow" type="button" data-hero-next aria-label="Следующий слайд">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>

    <div class="container hero__facts">
      <div class="hero__fact"><span class="hero__fact-num">5 направлений</span><span class="hero__fact-label">под одной крышей</span></div>
      <div class="hero__fact"><span class="hero__fact-num">Диагностика</span><span class="hero__fact-label">до каждой процедуры</span></div>
      <div class="hero__fact"><span class="hero__fact-num">Честный подход</span><span class="hero__fact-label">к результату и цене</span></div>
    </div>
  </section>

  <!-- 02 · НАПРАВЛЕНИЯ -->
  <section class="section directions" aria-labelledby="dir-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">01 · Направления</span>
        <h2 id="dir-title">Чем мы <span class="hl">занимаемся</span></h2>
      </div>
      <ul class="dir-list">
        {SERVICES.map((s, i) => (
          <li class="dir-row reveal" style={`--i:${i}`}>
            <a class="dir-row__link" href={`/services/${s.slug}/`} data-track="click_service">
              <span class="dir-row__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="dir-row__title">{s.title}</span>
              <span class="dir-row__summary muted">{s.summary}</span>
              <span class="dir-row__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 · ИЗБРАННЫЕ РАБОТЫ (поменяли местами с «Подходом») -->
  <section class="section gallery" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">02 · Визуальный язык</span>
        <h2 id="gallery-title">Как это <span class="hl">выглядит</span></h2>
        <p class="muted gallery__note">Визуальные слоты концептуальные. Заменяются на реальную съёмку студии.</p>
      </div>
      <div class="gallery__grid">
        {gallery.map((g, i) => (
          <div class={`gallery__cell gallery__cell--${g.span || 'default'} reveal`} style={`--i:${i}`}>
            <Figure image={g.img} images={g.imgs} ratio={g.ratio} tone={g.tone as any} label={g.label} sizes="(max-width: 560px) 90vw, 60vw" alt={`${g.label}, визуальный образ студии BEAUTYTROH`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 · ПАКЕТЫ (подняли выше) -->
  <PackagesSection />

  <!-- 05 · ПОДХОД -->
  <section class="section approach theme-dark" aria-labelledby="approach-title">
    <div class="container approach__inner">
      <div class="approach__lead reveal">
        <span class="index-num">03 · Подход</span>
        <h2 id="approach-title" class="approach__statement">
          Мы отвечаем за <span class="hl">результат</span>, а не продаём процедуры.
        </h2>
      </div>
      <div class="approach__cols">
        <div class="approach__item reveal">
          <h3>Результат</h3>
          <p class="muted">Обсуждаем, что реально получится именно у вас, ещё до процедуры, а не после. Если задуманное не подойдёт, скажем честно.</p>
        </div>
        <div class="approach__item reveal">
          <h3>Эстетика</h3>
          <p class="muted">Сдержанная, современная эстетика без лишнего декора. Дорого это про уместность и чистоту работы, а не про блеск.</p>
        </div>
        <div class="approach__item reveal">
          <h3>Мастер</h3>
          <p class="muted">Каждое направление ведёт специалист, который отвечает за результат и объясняет, что и зачем делает.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · МАСТЕРА -->
  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">04 · Команда</span>
        <h2 id="team-title">Мастера, которым можно доверить работу</h2>
      </div>
      <div class="team-preview">
        {teamPreview.map((m, i) => (
          <div class="reveal" style={`--i:${i}`}><MasterCard master={m} /></div>
        ))}
      </div>
      <a class="link-arrow team-preview__all" href="/team/">Вся команда <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 06 · ПРОСТРАНСТВО -->
  <section class="section section--alt space" aria-labelledby="space-title">
    <div class="container space__inner">
      <div class="space__media reveal">
        <Figure image={INTERIOR} ratio="4/5" tone="dark" label="Интерьер" frame="Свет · тишина · логистика" sizes="(max-width: 940px) 90vw, 45vw" alt="Современный тёплый интерьер студии BEAUTYTROH" />
      </div>
      <div class="space__text reveal">
        <span class="index-num">05 · Пространство</span>
        <h2 id="space-title">Обстановка, в которой спокойно</h2>
        <p class="lead">
          Свет, тишина и продуманная логистика: вы <span class="hl">не сидите в проходе</span> и
          никуда не спешите.
        </p>
        <p class="muted">
          Пространство спроектировано так, чтобы визит был спокойным, от встречи до финального
          зеркала. Меньше визуального шума, больше внимания к тому, за чем вы пришли.
        </p>
        <a class="link-arrow space__link" href="/about/">О студии <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 07 · ПРАЙС-ТИЗЕР -->
  <section class="section price-teaser" aria-labelledby="price-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">06 · Цены</span>
        <h2 id="price-title">Прозрачно, <span class="hl">без сюрпризов</span></h2>
      </div>
      <ul class="price-teaser__list reveal">
        {SERVICES.map((s) => (
          <li class="price-teaser__row">
            <a href={`/services/${s.slug}/`} class="price-teaser__name">{s.title}</a>
            <span class="price-teaser__dots" aria-hidden="true"></span>
            <span class="price-teaser__price">{s.procedures[0].price}</span>
          </li>
        ))}
      </ul>
      <a class="btn btn--ghost price-teaser__all" href="/prices/">Полный прайс <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 08 · ЖУРНАЛ -->
  <section class="section section--alt journal" aria-labelledby="journal-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">07 · Журнал</span>
        <h2 id="journal-title">Полезное о красоте без воды</h2>
      </div>
      <div class="journal__grid">
        {latestPosts.map((p, i) => (
          <a class="journal__card reveal" href={`/blog/${p.slug}/`} style={`--i:${i}`}>
            <span class="journal__cat">{p.category}</span>
            <h3 class="journal__card-title">{p.title}</h3>
            <p class="muted journal__excerpt">{p.description}</p>
            <span class="journal__meta muted">{p.readingTime}</span>
          </a>
        ))}
      </div>
      <a class="link-arrow journal__all" href="/blog/">Все материалы <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 08 · ЗАПИСЬ -->
  <BookingSection />
</BaseLayout>

<style>
  /* -------- HERO (editorial, фото «в край» справа) -------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--ivory);
    padding-top: clamp(9rem, 16vw, 13rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    min-height: clamp(600px, 88vh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* Фото на весь экран — одна цельная поверхность, без вертикального стыка */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    transform-origin: 65% 45%;
    animation: heroDrift 26s ease-in-out infinite alternate;
    will-change: transform;
  }
  /* Мягкое «дыхание» тёплого света справa — еле заметное мерцание. */
  .hero__shimmer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      60% 70% at 82% 42%,
      rgba(224, 158, 92, 0.22) 0%,
      rgba(224, 158, 92, 0.08) 38%,
      rgba(224, 158, 92, 0) 70%
    );
    mix-blend-mode: screen;
    opacity: 0.7;
    animation: heroShimmerLight 9s ease-in-out infinite;
  }
  /* Плавный тёмный градиент слева (à la Vogue): текст читается, справа виден
     салон. Один непрерывный оверлей — переходов-«ступенек» нет. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgba(23, 15, 9, 0.94) 0%,
        rgba(23, 15, 9, 0.86) 26%,
        rgba(23, 15, 9, 0.55) 48%,
        rgba(23, 15, 9, 0.12) 70%,
        rgba(23, 15, 9, 0) 88%),
      linear-gradient(to top, rgba(20, 13, 8, 0.5), rgba(20, 13, 8, 0) 26%),
      linear-gradient(to bottom, rgba(20, 13, 8, 0.4), rgba(20, 13, 8, 0) 16%);
  }
  .hero__inner { flex: 1; display: flex; align-items: center; }
  .hero__text { max-width: 34rem; }

  /* -------- HERO SLIDER -------- */
  .hero__slider { position: relative; width: 100%; overflow: hidden; }
  .hero__track {
    display: flex;
    transition: transform 0.75s cubic-bezier(0.65, 0, 0.1, 1);
    touch-action: pan-y;
  }
  .hero__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    opacity: 0.25;
    transition: opacity 0.6s var(--ease);
  }
  .hero__slide.is-active { opacity: 1; }
  /* Пока JS не подхватил — первый слайд уже виден корректно */
  .hero__slide:first-child { opacity: 1; }
  .hero__slider.is-ready .hero__slide:first-child:not(.is-active) { opacity: 0.25; }

  .hero__controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  .hero__arrow {
    flex: 0 0 auto;
    width: 2.9rem;
    height: 2.9rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(247, 240, 239, 0.3);
    background: rgba(23, 15, 9, 0.25);
    color: var(--ivory);
    font-size: 1.1rem;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .hero__arrow:hover {
    border-color: var(--clay-soft);
    background: rgba(189, 122, 69, 0.22);
    transform: translateY(-1px);
  }
  .hero__arrow:focus-visible { outline: 2px solid var(--clay-soft); outline-offset: 3px; }

  .hero__dots { display: flex; align-items: center; gap: 0.6rem; }
  .hero__dot-btn {
    width: 9px;
    height: 9px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(247, 240, 239, 0.32);
    cursor: pointer;
    transition: background 0.3s var(--ease), width 0.3s var(--ease);
  }
  .hero__dot-btn:hover { background: rgba(247, 240, 239, 0.6); }
  .hero__dot-btn[aria-selected='true'] {
    width: 24px;
    border-radius: 6px;
    background: var(--clay-soft);
  }
  .hero__dot-btn:focus-visible { outline: 2px solid var(--clay-soft); outline-offset: 3px; }
  .hero__dot {
    position: absolute;
    left: 0.6rem;
    top: 0.35em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--clay);
    box-shadow: 0 0 0 0 rgba(189, 122, 69, 0.6);
    animation: heroPulse 2.6s ease-out infinite;
  }
  .eyebrow--rule .hero__dot { left: 0; }
  .eyebrow--rule { padding-left: 1.6rem; }
  .eyebrow--rule::before { display: none; }
  .hero__title {
    color: var(--ivory);
    margin: 1.5rem 0;
    max-width: 15ch;
    font-size: clamp(3rem, 1.6rem + 6vw, 6.4rem);
    line-height: 1.02;
    font-weight: 400;
    text-wrap: balance;
  }
  /* Мерцающий карамельный акцент на ключевой строке */
  .hero__title em {
    font-style: normal;
    display: block;
    background: linear-gradient(100deg, var(--clay-soft) 0%, #fbe4c4 45%, var(--clay-soft) 70%);
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: heroShimmer 6s linear infinite;
  }

  /* Плавный вход элементов активного слайда (повторяется при каждой смене) */
  .hero__slide.is-active .hero__text > * { animation: heroIn 0.8s var(--ease) backwards; }
  .hero__slide.is-active .hero__text .eyebrow { animation-delay: 0.08s; }
  .hero__slide.is-active .hero__title { animation-delay: 0.18s; }
  .hero__slide.is-active .hero__lead { animation-delay: 0.3s; }
  .hero__slide.is-active .hero__text .hero__actions { animation-delay: 0.42s; }
  .hero__photo { animation: heroIn 1.2s var(--ease) 0.1s backwards; }
  .hero__facts { animation: heroIn 0.9s var(--ease) 0.65s backwards; }

  @keyframes heroIn {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* Еле заметный дрейф + зум фона (ощущение «живого» кадра) */
  @keyframes heroDrift {
    from { transform: scale(1.04) translate3d(0, 0, 0); }
    to { transform: scale(1.1) translate3d(-1.5%, -1%, 0); }
  }
  @keyframes heroShimmerLight {
    0%, 100% { opacity: 0.45; transform: translate3d(0, 0, 0); }
    50% { opacity: 0.85; transform: translate3d(-1.2%, 0.6%, 0); }
  }
  @keyframes heroShimmer {
    to { background-position: 220% center; }
  }
  @keyframes heroPulse {
    0% { box-shadow: 0 0 0 0 rgba(189, 122, 69, 0.55); }
    70%, 100% { box-shadow: 0 0 0 10px rgba(189, 122, 69, 0); }
  }
  .hero__lead { color: rgba(239, 231, 219, 0.9); max-width: 46ch; font-size: clamp(1.12rem, 1rem + 0.5vw, 1.42rem); }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  .hero__secondary { color: var(--ivory); }
  .hero__secondary:hover { color: var(--clay-soft); }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid rgba(247, 240, 239, 0.14);
  }
  .hero__fact { display: grid; gap: 0.2rem; }
  .hero__fact-num { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--clay-soft); }
  .hero__fact-label { font-size: 0.82rem; letter-spacing: 0.04em; color: rgba(247, 240, 239, 0.6); }

  /* -------- НАПРАВЛЕНИЯ (editorial index) -------- */
  .dir-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .dir-row { border-bottom: 1px solid var(--line); }
  .dir-row__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'num title arrow' 'num summary arrow';
    column-gap: 1.75rem;
    row-gap: 0.35rem;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    transition: padding-left 0.4s var(--ease);
  }
  .dir-row__link:hover { padding-left: 0.75rem; }
  .dir-row__num { grid-area: num; font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; color: var(--ink-muted); }
  .dir-row__title { grid-area: title; font-family: var(--font-display); font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem); font-weight: 500; line-height: 1.05; color: var(--ink); transition: color 0.3s var(--ease); }
  .dir-row__link:hover .dir-row__title { color: var(--accent-ink); }
  .dir-row__summary { grid-area: summary; font-size: 1rem; max-width: 52ch; }
  .dir-row__arrow { grid-area: arrow; font-size: 1.4rem; color: var(--accent-ink); transition: transform 0.4s var(--ease); }
  .dir-row__link:hover .dir-row__arrow { transform: translateX(6px); }

  /* -------- ПОДХОД -------- */
  .approach__inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .approach__statement { color: var(--ivory); max-width: 16ch; }
  .approach__cols { display: grid; gap: 2.25rem; }
  .approach__item { border-top: 1px solid rgba(247, 240, 239, 0.16); padding-top: 1.2rem; }
  .approach__item h3 { color: var(--ivory); margin-bottom: 0.5rem; }

  /* -------- ГАЛЕРЕЯ -------- */
  .gallery__note { margin-top: 0.75rem; font-size: 0.85rem; }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-auto-flow: dense;
  }
  .gallery__cell--tall { grid-row: span 2; }
  .gallery__cell--wide { grid-column: span 2; }

  /* -------- КОМАНДА (превью) -------- */
  .team-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .team-preview__all { margin-top: 2.5rem; }

  /* -------- ПРОСТРАНСТВО -------- */
  .space__inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .space__text .lead { margin: 1rem 0; }
  .space__link { margin-top: 1.75rem; }

  /* -------- ПРАЙС-ТИЗЕР -------- */
  .price-teaser__list { list-style: none; padding: 0; margin: 0; max-width: 720px; }
  .price-teaser__row { display: flex; align-items: baseline; gap: 1rem; padding: 1.05rem 0; border-bottom: 1px solid var(--line); }
  .price-teaser__name { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; color: var(--ink); border-bottom: 1px solid transparent; transition: border-color 0.3s var(--ease); }
  .price-teaser__name:hover { border-color: var(--accent); }
  .price-teaser__dots { flex: 1; border-bottom: 1px dotted var(--line); transform: translateY(-4px); }
  .price-teaser__price { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--accent-ink); white-space: nowrap; }
  .price-teaser__all { margin-top: 2rem; }

  /* -------- ЖУРНАЛ -------- */
  .journal__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .journal__card { display: grid; gap: 0.7rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--line); transition: border-color 0.3s var(--ease); }
  .journal__card:hover { border-color: var(--accent); }
  .journal__cat { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-ink); }
  .journal__card-title { font-size: 1.45rem; }
  .journal__excerpt { font-size: 0.96rem; }
  .journal__meta { font-size: 0.82rem; }
  .journal__all { margin-top: 2.5rem; }

  /* -------- RESPONSIVE -------- */
  @media (max-width: 940px) {
    .hero__photo { width: 100%; }
    .hero__veil {
      background:
        linear-gradient(to top, rgba(28, 19, 12, 0.88) 12%, rgba(28, 19, 12, 0.35) 55%, rgba(28, 19, 12, 0.5)),
        linear-gradient(100deg, rgba(36, 24, 17, 0.8), rgba(36, 24, 17, 0.4));
    }
    .hero__text { max-width: 100%; }
    .approach__inner { grid-template-columns: 1fr; }
    .space__inner { grid-template-columns: 1fr; }
    .space__media { max-width: 520px; }
    .team-preview { grid-template-columns: 1fr 1fr; }
    .journal__grid { grid-template-columns: 1fr; max-width: 560px; }
    .gallery__grid { grid-template-columns: repeat(2, 1fr); }
    .gallery__cell--wide { grid-column: span 2; }
  }
  @media (max-width: 560px) {
    .dir-row__link { grid-template-columns: auto 1fr; grid-template-areas: 'num title' 'num summary'; column-gap: 1rem; }
    .dir-row__arrow { display: none; }
    .team-preview { grid-template-columns: 1fr; max-width: 340px; }
    .gallery__cell--tall { grid-row: span 1; }
    .hero__controls { gap: 0.9rem; }
    .hero__arrow { width: 2.6rem; height: 2.6rem; }
  }

  /* Уважаем системную настройку «меньше движения» */
  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__shimmer { animation: none; }
    .hero__track { transition: none; }
    .hero__slide,
    .hero__slide.is-active .hero__text > * { transition: none; animation: none; }
  }
</style>

<script>
  class HeroSlider {
    root: HTMLElement;
    track: HTMLElement;
    slides: HTMLElement[];
    dots: HTMLElement[];
    index = 0;
    timer: number | null = null;
    delay: number;
    reduced: boolean;

    constructor(root: HTMLElement) {
      this.root = root;
      this.track = root.querySelector('[data-hero-track]') as HTMLElement;
      this.slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-slide]'));
      this.dots = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-dot]'));
      this.delay = Number(root.dataset.autoplay) || 6500;
      this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (this.slides.length <= 1) return;

      root.classList.add('is-ready');
      this.bind();
      this.go(0, false);
      if (!this.reduced) this.play();
    }

    bind() {
      this.root.querySelector('[data-hero-prev]')?.addEventListener('click', () => this.step(-1, true));
      this.root.querySelector('[data-hero-next]')?.addEventListener('click', () => this.step(1, true));
      this.dots.forEach((dot, i) =>
        dot.addEventListener('click', () => { this.go(i, true); this.restart(); })
      );

      // Пауза при наведении / фокусе
      this.root.addEventListener('mouseenter', () => this.pause());
      this.root.addEventListener('mouseleave', () => { if (!this.reduced) this.play(); });
      this.root.addEventListener('focusin', () => this.pause());
      this.root.addEventListener('focusout', () => { if (!this.reduced) this.play(); });

      // Клавиатура
      this.root.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') { this.step(-1, true); this.restart(); }
        if (e.key === 'ArrowRight') { this.step(1, true); this.restart(); }
      });

      // Свайп (touch + мышь)
      let startX = 0, dragging = false;
      const down = (x: number) => { startX = x; dragging = true; this.pause(); };
      const up = (x: number) => {
        if (!dragging) return;
        dragging = false;
        const dx = x - startX;
        if (Math.abs(dx) > 45) this.step(dx < 0 ? 1 : -1, true);
        if (!this.reduced) this.play();
      };
      this.track.addEventListener('touchstart', (e) => down(e.touches[0].clientX), { passive: true });
      this.track.addEventListener('touchend', (e) => up(e.changedTouches[0].clientX));
      this.track.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') down(e.clientX); });
      window.addEventListener('pointerup', (e) => { if (e.pointerType === 'mouse') up(e.clientX); });

      // Не крутим во вкладке в фоне
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) this.pause();
        else if (!this.reduced) this.play();
      });
    }

    go(i: number, animate: boolean) {
      this.index = (i + this.slides.length) % this.slides.length;
      if (!animate) this.track.style.transition = 'none';
      this.track.style.transform = `translateX(-${this.index * 100}%)`;
      if (!animate) requestAnimationFrame(() => (this.track.style.transition = ''));

      this.slides.forEach((s, n) => {
        const active = n === this.index;
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
        // Вне экрана — убираем из таб-порядка
        if (active) s.removeAttribute('inert');
        else s.setAttribute('inert', '');
      });
      this.dots.forEach((d, n) => d.setAttribute('aria-selected', n === this.index ? 'true' : 'false'));
    }

    step(dir: number, animate: boolean) { this.go(this.index + dir, animate); }

    play() {
      this.pause();
      this.timer = window.setInterval(() => this.step(1, true), this.delay);
    }
    pause() { if (this.timer) { clearInterval(this.timer); this.timer = null; } }
    restart() { if (!this.reduced) this.play(); }
  }

  const init = () => {
    document
      .querySelectorAll<HTMLElement>('[data-hero-slider]')
      .forEach((el) => new HeroSlider(el));
  };
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
</script>
