---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingSection from '../components/BookingSection.astro';
import PackagesSection from '../components/PackagesSection.astro';
import MasterCard from '../components/MasterCard.astro';
import Figure from '../components/Figure.astro';
import { Image } from 'astro:assets';
import { SERVICES } from '../data/services.mjs';
import { TEAM } from '../data/team.mjs';
import { POSTS } from '../data/posts.mjs';
import { SERVICE_IMAGES, INTERIOR, HAIR_STRIP, HERO_IMAGE } from '../data/media.mjs';
import { websiteSchema, organizationSchema, beautyBusinessSchema } from '../config/schema.mjs';

const teamPreview = TEAM.slice(0, 3);
const latestPosts = POSTS.slice(0, 3);

// Плитки визуальной галереи — реальные фото по направлениям, асимметрия.
// У «Волос» широкая плитка с ДВУМЯ фото рядом (hair + hair 2).
interface GalleryTile {
  label: string;
  img?: ImageMetadata;
  imgs?: ImageMetadata[];
  tone: string;
  ratio: string;
  span: string;
}
const gallery: GalleryTile[] = [
  { label: 'Окрашивание', img: SERVICE_IMAGES.okrashivanie, tone: 'warm', ratio: '4/5', span: 'tall' },
  { label: 'Маникюр', img: SERVICE_IMAGES.manikyur, tone: 'light', ratio: '1/1', span: '' },
  { label: 'Брови', img: SERVICE_IMAGES.brovi, tone: 'warm', ratio: '1/1', span: '' },
  { label: 'Уход за лицом', img: SERVICE_IMAGES['uhod-za-litsom'], tone: 'light', ratio: '4/5', span: 'tall' },
  { label: 'Волосы', imgs: HAIR_STRIP, tone: 'warm', ratio: '16/10', span: 'wide' },
];

const jsonLd = [websiteSchema(), organizationSchema({ logo: '/favicon.svg' }), beautyBusinessSchema({ image: '/images/og-cover.svg' })];
---

<BaseLayout seoKey="home" transparentHeader={true} jsonLd={jsonLd}>
  <!-- 01 · HERO — двухэтапный: бренд → «смотреть» → направления (скролл открывается после 2-го этапа) -->
  <section class="hero theme-dark" data-hero aria-label="BEAUTYTROH — студия красоты">
    <div class="hero__photo" aria-hidden="true">
      <Image
        src={HERO_IMAGE}
        alt=""
        widths={[600, 900, 1300, 1700]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__scrim"></div>
    </div>

    <!-- Этап 1 · бренд -->
    <div class="hero-stage hero-stage--intro is-active" data-hero-stage="intro">
      <div class="container hero-intro">
        <p class="hero-intro__eyebrow">Студия красоты</p>
        <h1 class="hero-intro__brand" id="hero-title">beautytroh</h1>
        <button class="hero-intro__enter" type="button" data-hero-enter>
          <span>смотреть</span><span class="hero-intro__enter-arrow" aria-hidden="true">↓</span>
        </button>
      </div>
    </div>

    <!-- Этап 2 · направления -->
    <div class="hero-stage hero-stage--dirs" data-hero-stage="dirs" aria-hidden="true">
      <div class="container hero-dirs">
        <div class="hero-dirs__head">
          <span class="index-num">BEAUTYTROH · студия красоты</span>
          <h2 class="hero-dirs__title">Чем мы <span class="hl">занимаемся</span></h2>
        </div>
        <ul class="hero-dirs__list">
          {SERVICES.map((s, i) => (
            <li class="hero-dir" style={`--i:${i}`}>
              <a class="hero-dir__link" href={`/services/${s.slug}/`} data-track="click_service">
                <span class="hero-dir__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="hero-dir__title">{s.title}</span>
                <span class="hero-dir__summary">{s.summary}</span>
                <span class="hero-dir__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="hero-dirs__more" href="#gallery-title" data-hero-continue>листать дальше <span class="arrow" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <!-- 03 · ИЗБРАННЫЕ РАБОТЫ (поменяли местами с «Подходом») -->
  <section class="section gallery" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">02 · Визуальный язык</span>
        <h2 id="gallery-title">Как это <span class="hl">выглядит</span></h2>
        <p class="muted gallery__note">Визуальные слоты концептуальные. Заменяются на реальную съёмку студии.</p>
      </div>
      <div class="gallery__grid">
        {gallery.map((g, i) => (
          <div class={`gallery__cell gallery__cell--${g.span || 'default'} reveal`} style={`--i:${i}`}>
            <Figure image={g.img} images={g.imgs} ratio={g.ratio} tone={g.tone as any} label={g.label} sizes="(max-width: 560px) 90vw, 60vw" alt={`${g.label}, визуальный образ студии BEAUTYTROH`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 · ПАКЕТЫ (подняли выше) -->
  <PackagesSection />

  <!-- 06 · МАСТЕРА -->
  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">04 · Команда</span>
        <h2 id="team-title">Мастера, которым можно доверить работу</h2>
      </div>
      <div class="team-preview">
        {teamPreview.map((m, i) => (
          <div class="reveal" style={`--i:${i}`}><MasterCard master={m} /></div>
        ))}
      </div>
      <a class="link-arrow team-preview__all" href="/team/">Вся команда <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 06 · ПРОСТРАНСТВО -->
  <section class="section section--alt space" aria-labelledby="space-title">
    <div class="container space__inner">
      <div class="space__media reveal">
        <Figure image={INTERIOR} ratio="4/5" tone="dark" label="Интерьер" frame="Свет · тишина · логистика" sizes="(max-width: 940px) 90vw, 45vw" alt="Современный тёплый интерьер студии BEAUTYTROH" />
      </div>
      <div class="space__text reveal">
        <span class="index-num">05 · Пространство</span>
        <h2 id="space-title">Обстановка, в которой спокойно</h2>
        <p class="lead">
          Свет, тишина и продуманная логистика: вы <span class="hl">не сидите в проходе</span> и
          никуда не спешите.
        </p>
        <p class="muted">
          Пространство спроектировано так, чтобы визит был спокойным, от встречи до финального
          зеркала. Меньше визуального шума, больше внимания к тому, за чем вы пришли.
        </p>
        <a class="link-arrow space__link" href="/about/">О студии <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 07 · ПРАЙС-ТИЗЕР -->
  <section class="section price-teaser" aria-labelledby="price-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">06 · Цены</span>
        <h2 id="price-title">Прозрачно, <span class="hl">без сюрпризов</span></h2>
      </div>
      <ul class="price-teaser__list reveal">
        {SERVICES.map((s) => (
          <li class="price-teaser__row">
            <a href={`/services/${s.slug}/`} class="price-teaser__name">{s.title}</a>
            <span class="price-teaser__dots" aria-hidden="true"></span>
            <span class="price-teaser__price">{s.procedures[0].price}</span>
          </li>
        ))}
      </ul>
      <a class="btn btn--ghost price-teaser__all" href="/prices/">Полный прайс <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 08 · ЖУРНАЛ -->
  <section class="section section--alt journal" aria-labelledby="journal-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="index-num">07 · Журнал</span>
        <h2 id="journal-title">Полезное о красоте без воды</h2>
      </div>
      <div class="journal__grid">
        {latestPosts.map((p, i) => (
          <a class="journal__card reveal" href={`/blog/${p.slug}/`} style={`--i:${i}`}>
            <span class="journal__cat">{p.category}</span>
            <h3 class="journal__card-title">{p.title}</h3>
            <p class="muted journal__excerpt">{p.description}</p>
            <span class="journal__meta muted">{p.readingTime}</span>
          </a>
        ))}
      </div>
      <a class="link-arrow journal__all" href="/blog/">Все материалы <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 08 · ЗАПИСЬ -->
  <BookingSection />
</BaseLayout>

<style>
  /* ============================================================
     HERO — двухэтапный: бренд (этап 1) → направления (этап 2).
     Скролл сайта заблокирован, пока гость не перешёл ко 2-му этапу.
     ============================================================ */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--ivory);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .hero__photo { position: absolute; inset: 0; z-index: -1; }
  .hero__img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: 62% center;
    transform: scale(1.04);
    filter: saturate(0.5) brightness(0.62) contrast(1.03);
  }
  /* Центральное розовое свечение (сверху) + мягкое затемнение по краям.
     Свечение по центру даёт «живой» фон даже на узком телефоне. */
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(58% 48% at 50% 50%, rgba(255,79,151,0.30), rgba(255,79,151,0) 72%),
      radial-gradient(120% 95% at 50% 42%, rgba(10,9,12,0.3), rgba(10,9,12,0.8) 100%),
      linear-gradient(0deg, rgba(10,9,12,0.96) 0%, rgba(10,9,12,0.22) 55%, rgba(10,9,12,0.4) 100%);
  }

  /* --- общий слой этапа --- */
  .hero-stage { flex: 1; display: flex; align-items: center; }
  .hero-stage .container { width: 100%; }

  /* Без JS этапы идут друг за другом (контент доступен и листается).
     С JS — «ворота»: этап 1 поверх всего экрана, этап 2 скрыт до клика. */
  :global(html.js) .hero-stage--intro {
    position: absolute; inset: 0;
    transition: opacity 1s var(--ease), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 1s var(--ease);
  }
  :global(html.js) .hero-stage--intro.is-leaving { opacity: 0; transform: scale(1.1); filter: blur(8px); pointer-events: none; }
  :global(html.js) .hero-stage--intro.is-gone { display: none; }
  :global(html.js) .hero-stage--dirs {
    opacity: 0;
    visibility: hidden;
    transform: translateY(44px);
    transition: opacity 1.1s var(--ease), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 1.2s;
  }
  :global(html.js) .hero-stage--dirs.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 1.2s var(--ease) 0.3s, transform 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
  }

  /* --- Этап 1: бренд (порядок: бренд → ярлык-тэглайн → кнопка) --- */
  .hero-intro { text-align: center; display: grid; justify-items: center; gap: clamp(1.4rem, 3.5vw, 2.25rem); position: relative; }
  .hero-intro__brand {
    order: 1;
    font-family: var(--font-script);
    font-weight: 400;
    color: var(--ivory);
    font-size: clamp(5rem, 23vw, 19rem);
    line-height: 0.8;
    margin: 0;
    letter-spacing: 0.005em;
    /* многослойное розовое свечение под надписью */
    text-shadow:
      0 0 36px rgba(255, 79, 151, 0.55),
      0 2px 90px rgba(255, 79, 151, 0.5),
      0 6px 180px rgba(255, 79, 151, 0.35);
  }
  /* люкс-ярлык: тонкие линии по бокам, деликатный трекинг */
  .hero-intro__eyebrow {
    order: 2;
    display: inline-flex; align-items: center; gap: 1.1em;
    font-family: var(--font-body);
    font-size: clamp(0.64rem, 0.58rem + 0.3vw, 0.8rem);
    font-weight: 500; letter-spacing: 0.52em; text-transform: uppercase;
    color: rgba(245, 238, 242, 0.8);
    margin: 0;
    padding-left: 0.52em;
  }
  .hero-intro__eyebrow::before,
  .hero-intro__eyebrow::after {
    content: ''; width: clamp(1.75rem, 6vw, 3.75rem); height: 1px;
    background: linear-gradient(90deg, transparent, var(--clay-soft));
  }
  .hero-intro__eyebrow::after { background: linear-gradient(90deg, var(--clay-soft), transparent); }

  .hero-intro__enter {
    order: 3;
    position: relative;
    display: inline-flex; align-items: center; gap: 0.8em;
    margin-top: clamp(0.5rem, 1.5vw, 1rem);
    font-family: var(--font-body); font-weight: 600;
    font-size: 0.82rem; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--ivory);
    background: rgba(255, 79, 151, 0.08);
    border: 1px solid rgba(255, 79, 151, 0.5);
    border-radius: 999px;
    padding: 1.15em 2.5em;
    cursor: pointer;
    box-shadow: 0 0 0 0 rgba(255, 79, 151, 0.5);
    animation: enterPulse 2.8s ease-in-out infinite;
    transition: background 0.45s var(--ease), color 0.45s var(--ease),
      border-color 0.45s var(--ease), transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .hero-intro__enter:hover {
    background: var(--clay); border-color: var(--clay); color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 16px 44px -8px rgba(255, 79, 151, 0.6);
    animation: none;
  }
  .hero-intro__enter:focus-visible { outline: 2px solid var(--clay-soft); outline-offset: 4px; }
  .hero-intro__enter-arrow { animation: enterBob 1.8s ease-in-out infinite; transition: transform 0.5s var(--ease); }
  .hero-intro__enter:hover .hero-intro__enter-arrow { transform: translateY(4px); animation: none; }
  @keyframes enterPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 79, 151, 0.45); }
    70% { box-shadow: 0 0 0 18px rgba(255, 79, 151, 0); }
  }
  @keyframes enterBob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px); } }

  /* красивое появление этапа 1 (только с JS) */
  :global(html.js) .hero-intro__brand { animation: brandReveal 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s backwards; }
  :global(html.js) .hero-intro__eyebrow { animation: heroRise 1s var(--ease) 0.75s backwards; }
  :global(html.js) .hero-intro__enter { animation: heroRise 1s var(--ease) 1s backwards, enterPulse 2.8s ease-in-out 2s infinite; }
  :global(html.js) .hero-intro__enter:hover { animation: none; }
  @keyframes brandReveal {
    from { opacity: 0; transform: translateY(32px) scale(0.96); filter: blur(12px); }
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- Этап 2: направления --- */
  .hero-dirs {
    padding-block: clamp(6rem, 13vh, 9rem) clamp(2rem, 5vh, 3rem);
    display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); align-content: center;
  }
  .hero-dirs__head .index-num { display: block; margin-bottom: 0.9rem; color: var(--clay-soft); }
  .hero-dirs__title { color: var(--ivory); font-size: clamp(2rem, 1.4rem + 3vw, 3.6rem); margin: 0; }
  .hero-dirs__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .hero-dir { border-bottom: 1px solid var(--line); }
  .hero-dir__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'num title arrow' 'num summary arrow';
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: 0.3rem;
    align-items: center;
    padding: clamp(0.95rem, 2.2vw, 1.5rem) 0.6rem;
    transition: padding-left 0.4s var(--ease), background 0.4s var(--ease);
  }
  .hero-dir__link:hover,
  .hero-dir__link:focus-visible { padding-left: 1.3rem; background: rgba(255, 79, 151, 0.07); outline: none; }
  .hero-dir__num { grid-area: num; font-family: var(--font-body); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.1em; color: var(--clay-soft); }
  .hero-dir__title { grid-area: title; font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.6rem); line-height: 1.05; color: var(--ivory); transition: color 0.3s var(--ease); }
  .hero-dir__link:hover .hero-dir__title,
  .hero-dir__link:focus-visible .hero-dir__title { color: var(--clay-soft); }
  .hero-dir__summary { grid-area: summary; font-size: 0.95rem; color: var(--ink-muted); max-width: 60ch; }
  .hero-dir__arrow { grid-area: arrow; font-size: 1.4rem; color: var(--clay-soft); transition: transform 0.4s var(--ease); }
  .hero-dir__link:hover .hero-dir__arrow,
  .hero-dir__link:focus-visible .hero-dir__arrow { transform: translateX(6px); }
  .hero-dirs__more {
    justify-self: center;
    display: inline-flex; align-items: center; gap: 0.5em;
    font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink-muted);
    transition: color 0.3s var(--ease);
  }
  .hero-dirs__more:hover { color: var(--clay-soft); }

  /* Аккуратное поочерёдное появление заголовка и направлений на 2-м этапе */
  :global(html.js) .hero-stage--dirs .hero-dirs__head,
  :global(html.js) .hero-stage--dirs .hero-dir,
  :global(html.js) .hero-stage--dirs .hero-dirs__more { opacity: 0; }
  :global(html.js) .hero-stage--dirs.is-active .hero-dirs__head { animation: dirRise 0.8s var(--ease) 0.45s forwards; }
  :global(html.js) .hero-stage--dirs.is-active .hero-dir {
    animation: dirRise 0.8s var(--ease) forwards;
    animation-delay: calc(0.65s + var(--i) * 0.13s);
  }
  :global(html.js) .hero-stage--dirs.is-active .hero-dirs__more { animation: dirRise 0.8s var(--ease) 1.5s forwards; }
  @keyframes dirRise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 680px) {
    .hero-dir__link { grid-template-areas: 'num title arrow'; }
    .hero-dir__summary { display: none; }
  }

  /* -------- НАПРАВЛЕНИЯ (editorial index) -------- */
  .dir-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .dir-row { border-bottom: 1px solid var(--line); }
  .dir-row__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'num title arrow' 'num summary arrow';
    column-gap: 1.75rem;
    row-gap: 0.35rem;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    transition: padding-left 0.4s var(--ease);
  }
  .dir-row__link:hover { padding-left: 0.75rem; }
  .dir-row__num { grid-area: num; font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; color: var(--ink-muted); }
  .dir-row__title { grid-area: title; font-family: var(--font-display); font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem); font-weight: 500; line-height: 1.05; color: var(--ink); transition: color 0.3s var(--ease); }
  .dir-row__link:hover .dir-row__title { color: var(--accent-ink); }
  .dir-row__summary { grid-area: summary; font-size: 1rem; max-width: 52ch; }
  .dir-row__arrow { grid-area: arrow; font-size: 1.4rem; color: var(--accent-ink); transition: transform 0.4s var(--ease); }
  .dir-row__link:hover .dir-row__arrow { transform: translateX(6px); }

  /* -------- ПОДХОД -------- */
  .approach__inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .approach__statement { color: var(--ivory); max-width: 16ch; }
  .approach__cols { display: grid; gap: 2.25rem; }
  .approach__item { border-top: 1px solid rgba(247, 240, 239, 0.16); padding-top: 1.2rem; }
  .approach__item h3 { color: var(--ivory); margin-bottom: 0.5rem; }

  /* -------- ГАЛЕРЕЯ -------- */
  .gallery__note { margin-top: 0.75rem; font-size: 0.85rem; }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-auto-flow: dense;
  }
  .gallery__cell--tall { grid-row: span 2; }
  .gallery__cell--wide { grid-column: span 2; }

  /* -------- КОМАНДА (превью) -------- */
  .team-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .team-preview__all { margin-top: 2.5rem; }

  /* -------- ПРОСТРАНСТВО -------- */
  .space__inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .space__text .lead { margin: 1rem 0; }
  .space__link { margin-top: 1.75rem; }

  /* -------- ПРАЙС-ТИЗЕР -------- */
  .price-teaser__list { list-style: none; padding: 0; margin: 0; max-width: 720px; }
  .price-teaser__row { display: flex; align-items: baseline; gap: 1rem; padding: 1.05rem 0; border-bottom: 1px solid var(--line); }
  .price-teaser__name { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; color: var(--ink); border-bottom: 1px solid transparent; transition: border-color 0.3s var(--ease); }
  .price-teaser__name:hover { border-color: var(--accent); }
  .price-teaser__dots { flex: 1; border-bottom: 1px dotted var(--line); transform: translateY(-4px); }
  .price-teaser__price { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--accent-ink); white-space: nowrap; }
  .price-teaser__all { margin-top: 2rem; }

  /* -------- ЖУРНАЛ -------- */
  .journal__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .journal__card { display: grid; gap: 0.7rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--line); transition: border-color 0.3s var(--ease); }
  .journal__card:hover { border-color: var(--accent); }
  .journal__cat { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-ink); }
  .journal__card-title { font-size: 1.45rem; }
  .journal__excerpt { font-size: 0.96rem; }
  .journal__meta { font-size: 0.82rem; }
  .journal__all { margin-top: 2.5rem; }

  /* -------- RESPONSIVE -------- */
  @media (max-width: 940px) {
    .hero__main { grid-template-columns: 1fr; gap: clamp(2rem, 7vw, 3rem); }
    .hero__facts {
      grid-template-columns: 1fr 1fr;
      gap: 1rem 1.5rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--line);
    }
    .approach__inner { grid-template-columns: 1fr; }
    .space__inner { grid-template-columns: 1fr; }
    .space__media { max-width: 520px; }
